# Copie estes nomes para a Vercel em Settings → Environments → Production.
# NÃO coloque a chave real neste arquivo nem no index.html.
# Nenhuma chave é obrigatória: o provador funciona com a IA gratuita.

# IA gratuita do provador (opcional, aumenta a cota): token "Read" em https://huggingface.co/settings/tokens
# HF_TOKEN=cole-o-token-somente-na-vercel

# Chat Moda Click IA (grátis): https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-a-chave-somente-na-vercel

# (Opcional, pago) Provador pela FASHN: https://app.fashn.ai
# FASHN_API_KEY=cole-a-chave-somente-na-vercel

# Opcionais:
# GEMINI_MODEL=gemini-3.8-flash
# FASHN_MODE=balanced
# ALLOWED_ORIGINS=null
